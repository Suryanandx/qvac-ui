{
  "name": "qvac-ui",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "QVAC UI: a private, local-first AI copilot built on the QVAC SDK, with one central brain, skills, connectors, MCP and OpenUI cards. Independent project; not affiliated with Tether or Thesys.",
  "main": "desktop/main.cjs",
  "scripts": {
    "build": "vite build",
    "start": "node server/index.mjs",
    "desktop": "npm run build && electron .",
    "test": "node --test tests/*.test.mjs",
    "check": "npm run build && npm test",
    "setup:workspace": "node scripts/setup-workspace.mjs",
    "open": "node scripts/open-local.mjs",
    "test:native-harness": "node scripts/test-native-harness.mjs",
    "download:models": "node scripts/download-models.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "@openuidev/lang-core": "1.0.2",
    "@openuidev/react-lang": "1.0.2",
    "@qvac/sdk": "0.22.0",
    "b4a": "1.9.0",
    "csv-parse": "7.0.3",
    "lucide-react": "^0.468.0",
    "mammoth": "1.13.0",
    "pdfjs-dist": "6.4.299",
    "pg": "8.23.1",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "electron": "45.1.0",
    "vite": "8.3.5"
  },
  "engines": {
    "node": ">=22.13"
  },
  "overrides": {
    "zod": "4.6.6"
  },
  "license": "Apache-2.0",
  "keywords": [
    "qvac",
    "local-ai",
    "llm",
    "copilot",
    "mcp",
    "openui",
    "agent",
    "skills",
    "offline",
    "privacy"
  ]
}
